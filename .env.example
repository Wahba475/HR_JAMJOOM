# Copy to .ENV and fill in. Never commit the filled-in file.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Object storage (Neon Object Storage, S3-compatible) ---
AWS_ENDPOINT_URL_S3=https://your-bucket.storage.region.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
BUCKET_NAME=cv1

# --- LLM ---
OPENAI_API_KEY=sk-...
SCORE_MODEL=gpt-4.1-mini
RANK_MODEL=gpt-5.4-mini

# --- Google Sheets export (optional) ---
# Path to the service-account JSON. Keep the file OUTSIDE this repo.
GOOGLE_CREDENTIALS_PATH=C:/Users/you/.secrets/service-account.json
SHEET_SHARE_WITH=you@gmail.com

# --- Frontend ---
# Set in cv-filter-frontend/.env
# VITE_API_URL=http://localhost:8000
